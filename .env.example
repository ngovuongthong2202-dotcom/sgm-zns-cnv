# Server & App Config
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# AI Configuration (Optional)
GEMINI_API_KEY=""

# Cron Secret for internal jobs
CRON_SECRET=""

# Supabase Configuration
# Frontend access (Vite client)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Backend Express access (Service role bypasses RLS for webhooks and cron)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Bypass Auth in development mode (true = auto-login as Admin with Dev Role Switcher)
DEV_BYPASS_AUTH=true
